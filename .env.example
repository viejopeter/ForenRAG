# ForenRAG environment configuration

# OpenSearch and Wazuh telemetry
OPENSEARCH_URL=https://<OPENSEARCH_HOST>:9200
OPENSEARCH_USER=<OPENSEARCH_USERNAME>
OPENSEARCH_PASSWORD=<STRONG_PASSWORD>
OPENSEARCH_REQUEST_TIMEOUT_SECONDS=30
# The lab default disables certificate verification. Enable it outside the lab.
OPENSEARCH_VERIFY_TLS=false
# Optional CA certificate bundle used when OPENSEARCH_VERIFY_TLS=true.
OPENSEARCH_CA_BUNDLE=
WAZUH_AGENT_ID=<WAZUH_AGENT_ID>

# Collector and session consolidation
MIN_RULE_LEVEL=12
SETTLING_WINDOW_SECONDS=15.0

# Ollama and embedding models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=16384
LLM_NUM_PREDICT=6144

# RAG retrieval and vector database
RAG_TOP_K=3
RAG_CANDIDATE_MULTIPLIER=4
CHROMA_CHUNK_SIZE=1000
CHROMA_CHUNK_OVERLAP=150
