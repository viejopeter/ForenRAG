# =================================================================
# ForenRAG Master Environment Configuration Template
# Copy this file to .env and adjust values for your environment
# =================================================================

# --- 1. OpenSearch / Wazuh Server Telemetry Settings ---
OPENSEARCH_URL=https://<OPENSEARCH_IP>:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
WAZUH_AGENT_ID=002

# --- 2. Collector & Session Consolidation Settings ---
MIN_RULE_LEVEL=12
SETTLING_WINDOW_SECONDS=15.0

# --- 3. Ollama Local AI & Embedding Model Settings ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=16384
LLM_NUM_PREDICT=6144

# --- 4. RAG Knowledge Retrieval & Vector DB Settings ---
RAG_TOP_K=3
RAG_CANDIDATE_MULTIPLIER=4
CHROMA_CHUNK_SIZE=400
CHROMA_CHUNK_OVERLAP=50
