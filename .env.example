# =================================================================
# ForenRAG Environment Configuration Template
# Copy this file to .env and fill in your environment details
# =================================================================

# OpenSearch / Wazuh Indexer Server URL (Port 9200)
OPENSEARCH_URL=https://<OPENSEARCH_IP>:9200

# OpenSearch Authentication Credentials (Default: admin / admin)
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin

# Target Wazuh Agent ID to monitor (e.g., 001, 002, 003)
WAZUH_AGENT_ID=001

# Minimum Wazuh Rule Level to trigger incident collection (Default: 12)
MIN_RULE_LEVEL=12

# Time window (seconds) to group related sub-alerts into 1 incident package
SETTLING_WINDOW_SECONDS=15.0
